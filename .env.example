# Copy to .env and fill in. Never commit the real .env.
VAULT_ENV=production
# Generate each key with:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
VAULT_MASTER_KEY=
VAULT_SECRET_KEY=
# SQLite for a single instance, or e.g. postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:////data/vault.db
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to false ONLY for plain-http local development
COOKIE_SECURE=true
